@{
    ViewData["Title"] = "Liên hệ – TechStore";
}
<div class="container section">
    <div style="max-width:800px;margin:0 auto;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:40px;box-shadow:var(--shadow)">
        <h1 style="color:var(--primary);margin-bottom:16px">📞 Liên hệ với TechStore</h1>
        <p style="color:var(--text-2);margin-bottom:24px">Chúng tôi luôn sẵn sàng lắng nghe mọi phản hồi và hỗ trợ bạn nhanh nhất!</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:30px">
            <div style="padding:20px;background:var(--bg);border-radius:var(--radius-sm)">
                <div style="font-weight:700;margin-bottom:6px">🏢 Trụ sở chính</div>
                <div style="font-size:13.5px;color:var(--text-2)">Tòa nhà Công Nghệ, Cầu Giấy, Hà Nội</div>
            </div>
            <div style="padding:20px;background:var(--bg);border-radius:var(--radius-sm)">
                <div style="font-weight:700;margin-bottom:6px">📞 Hotline hỗ trợ</div>
                <div style="font-size:13.5px;color:var(--text-2)">1800-xxxx (Miễn phí cuộc gọi, 8:00 - 22:00)</div>
            </div>
            <div style="padding:20px;background:var(--bg);border-radius:var(--radius-sm)">
                <div style="font-weight:700;margin-bottom:6px">📧 Email tiếp nhận</div>
                <div style="font-size:13.5px;color:var(--text-2)">support@techstore.vn</div>
            </div>
            <div style="padding:20px;background:var(--bg);border-radius:var(--radius-sm)">
                <div style="font-weight:700;margin-bottom:6px">💳 Thanh toán chuyển khoản</div>
                <div style="font-size:13.5px;color:var(--text-2)">MB Bank: <strong>1220820056666</strong> (Hà Phương Nam)</div>
            </div>
        </div>
        <div style="text-align:center">
            <button class="btn btn-primary" onclick="toggleFloatingChat()">💬 Chat trực tiếp với CSKH ngay</button>
        </div>
    </div>
</div>
