@{
    ViewData["Title"] = "Về chúng tôi – TechStore";
}
<div class="container section">
    <div style="max-width:800px;margin:0 auto;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:40px;box-shadow:var(--shadow)">
        <h1 style="color:var(--primary);margin-bottom:16px">⚡ Về TechStore</h1>
        <p style="font-size:16px;color:var(--text-2);margin-bottom:20px;line-height:1.8">
            TechStore là chuỗi bán lẻ thiết bị công nghệ và điện tử tiêu dùng chính hãng hàng đầu tại Việt Nam. Chúng tôi cam kết mang tới cho khách hàng trải nghiệm mua sắm an tâm, tiện lợi với các sản phẩm công nghệ cao cấp nhất.
        </p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-top:30px">
            <div style="padding:20px;background:var(--bg);border-radius:var(--radius-sm)">
                <div style="font-size:28px;margin-bottom:8px">🛡️</div>
                <div style="font-weight:700;margin-bottom:4px">100% Chính Hãng</div>
                <div style="font-size:13px;color:var(--text-3)">Bảo hành chính hãng 12-24 tháng theo tiêu chuẩn nhà sản xuất.</div>
            </div>
            <div style="padding:20px;background:var(--bg);border-radius:var(--radius-sm)">
                <div style="font-size:28px;margin-bottom:8px">⚡</div>
                <div style="font-weight:700;margin-bottom:4px">Giao Siêu Tốc 2H</div>
                <div style="font-size:13px;color:var(--text-3)">Nhận hàng ngay trong 2 giờ tại nội thành Hà Nội & TP.HCM.</div>
            </div>
            <div style="padding:20px;background:var(--bg);border-radius:var(--radius-sm)">
                <div style="font-size:28px;margin-bottom:8px">💬</div>
                <div style="font-weight:700;margin-bottom:4px">Hỗ Trợ 24/7 & AI</div>
                <div style="font-size:13px;color:var(--text-3)">Đội ngũ tư vấn tận tâm kết hợp trợ lý AI thông minh giải đáp nhanh.</div>
            </div>
        </div>
        <div style="margin-top:30px;text-align:center">
            <a href="/" class="btn btn-primary">Khám phá sản phẩm ngay →</a>
        </div>
    </div>
</div>
