@{
    ViewData["Title"] = "Bàn làm việc CSKH Desk";
}

<div id="page-support" class="page">
    <div class="cskh-container">
        <!-- Sidebar: Customer List (Messenger Style) -->
        <div class="cskh-sidebar">
            <div class="cskh-sidebar-header">
                <div style="font-size:18px;font-weight:800;display:flex;align-items:center;gap:8px;color:var(--text)">
                    🎧 Bàn Làm Việc CSKH
                </div>
                <div style="font-size:12px;color:var(--text-3);margin-top:4px">
                    Tiếp nhận & tư vấn trực tuyến khách hàng
                </div>
                <div style="margin-top:12px">
                    <input type="text" id="cskh-search-input" placeholder="🔍 Tìm kiếm khách hàng, tin nhắn..." 
                           oninput="filterCskhConversations()"
                           style="width:100%;box-sizing:border-box;padding:9px 14px;border:1.5px solid var(--border);border-radius:20px;font-size:13px;outline:none;background:var(--bg)">
                </div>
                <!-- Filter Tabs: Tránh 2-3 nhân viên CSKH hỗ trợ trùng người -->
                <div class="cskh-filter-tabs" style="display:flex;gap:4px;margin-top:10px;background:#f1f5f9;padding:3px;border-radius:10px">
                    <button type="button" class="cskh-tab-btn active" id="cskh-tab-waiting" onclick="setCskhFilter('waiting')" style="flex:1;padding:6px 0;font-size:12px;border:none;border-radius:8px;cursor:pointer;font-weight:600;background:#fff;color:#f59e0b;box-shadow:0 1px 3px rgba(0,0,0,.08)">🟡 Chờ nhận</button>
                    <button type="button" class="cskh-tab-btn" id="cskh-tab-my" onclick="setCskhFilter('my')" style="flex:1;padding:6px 0;font-size:12px;border:none;border-radius:8px;cursor:pointer;font-weight:600;background:transparent;color:#64748b">🟢 Khách của tôi</button>
                </div>
            </div>
            <div class="cskh-conversations-list" id="cskh-conversations-list">
                <!-- Customer items rendered dynamically -->
            </div>

        </div>

        <!-- Main Chat Area (Messenger Style) -->
        <div class="cskh-main-chat">
            <!-- Active Customer Header -->
            <div class="cskh-chat-header" id="cskh-chat-header">
                <div style="display:flex;align-items:center;gap:12px">
                    <div id="cskh-header-avatar" style="position:relative;display:none">
                        <div id="cskh-header-avatar-circle" style="width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,#e0e7ff,#c7d2fe);color:#4338ca;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;box-shadow:0 2px 6px rgba(0,0,0,.08)">
                            👤
                        </div>
                        <div style="position:absolute;bottom:1px;right:1px;width:10px;height:10px;background:#22c55e;border:2px solid #fff;border-radius:50%"></div>
                    </div>
                    <div>
                        <h3 id="cskh-active-customer-name" style="margin:0;font-size:16.5px;font-weight:700;color:var(--text)">Chọn một khách hàng để bắt đầu</h3>
                        <div id="cskh-active-customer-info" style="font-size:12px;color:var(--text-3);margin-top:2px">Vui lòng bấm vào khách hàng bên trái để xem tin nhắn</div>
                    </div>
                </div>
                <div id="cskh-customer-actions" style="display:flex;align-items:center;gap:8px">
                    <button class="btn btn-sm" id="cskh-claim-btn" onclick="claimActiveCskhConversation()" style="display:none;background:#10b981;color:#fff;border:none;font-weight:600;padding:7px 14px;border-radius:8px" title="Nhận phụ trách khách hàng này">✋ Tiếp nhận khách hàng</button>
                    <button class="btn btn-sm btn-outline" id="cskh-transfer-btn" onclick="openCskhTransferModal()" style="display:none;padding:7px 12px;border-radius:8px;display:none;align-items:center;gap:5px" title="Chuyển giao khách hàng cho nhân viên khác mà không cần hoàn tất">🔄 Chuyển giao</button>
                    <button class="btn btn-sm" id="cskh-close-btn" onclick="closeActiveCskhConversation()" style="display:none;background:#6366f1;color:#fff;border:none;padding:7px 12px;border-radius:8px" title="Hoàn tất và đóng phiên hỗ trợ">✅ Hoàn tất</button>
                    <button class="btn btn-outline btn-sm" onclick="loadSupportConversations()" title="Làm mới danh sách khách hàng">🔄 Làm mới</button>
                    <button class="btn btn-sm" id="cskh-delete-btn" onclick="deleteActiveCskhConversation()" style="display:none;background:#fee2e2;color:#dc2626;border:1px solid #fecaca;padding:7px 12px;border-radius:8px" title="Xóa toàn bộ tin nhắn của khách hàng này">🗑️</button>
                </div>
            </div>

            <!-- Assignment Info Banner -->
            <div id="cskh-assignment-banner" style="display:none;padding:9px 24px;font-size:12.5px;border-bottom:1px solid var(--border);align-items:center;justify-content:space-between"></div>

            <!-- Active Messages Body -->
            <div class="cskh-chat-messages" id="cskh-chat-messages">
                <div style="text-align:center;padding:80px 20px;color:var(--text-3)">
                    <div style="font-size:48px;margin-bottom:12px">💬</div>
                    <div style="font-size:15px;font-weight:600">Chưa chọn khách hàng nào</div>
                    <div style="font-size:13px;margin-top:4px">Vui lòng chọn khách hàng từ danh sách bên trái để phản hồi</div>
                </div>
            </div>

            <!-- Reply Input Box -->
            <form id="cskh-reply-form" onsubmit="handleCskhStaffReply(event)" class="cskh-reply-box" style="display:none">
                <input type="text" id="cskh-reply-input" placeholder="Nhập câu trả lời tư vấn cho khách hàng..." autocomplete="off">
                <button type="submit" class="btn btn-primary" id="cskh-reply-btn" style="padding:10px 22px;font-weight:600;border-radius:24px;display:flex;align-items:center;gap:6px">
                    <span>Gửi</span> <span>➤</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Modal Chuyển Giao Khách Hàng (Không cần hoàn tất, lưu lại 100% lịch sử chat) -->
    <div id="cskh-transfer-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,0.5);z-index:99999;align-items:center;justify-content:center;backdrop-filter:blur(2px)">
        <div style="background:#fff;border-radius:16px;padding:24px;width:90%;max-width:440px;box-shadow:0 20px 40px rgba(0,0,0,0.22)">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
                <div style="font-size:17px;font-weight:700;display:flex;align-items:center;gap:8px;color:var(--text)">
                    🔄 Chuyển Giao Khách Hàng
                </div>
                <button type="button" onclick="closeCskhTransferModal()" style="background:none;border:none;font-size:18px;cursor:pointer;color:var(--text-3)">✕</button>
            </div>
            <p style="font-size:13px;color:var(--text-2);margin-bottom:16px;line-height:1.5">
                Chuyển giao khách hàng cho nhân viên khác tiếp tục hỗ trợ mà <strong>không cần hoàn tất phiên</strong>. Toàn bộ lịch sử trao đổi được bảo lưu nguyên vẹn 100%.
            </p>
            <div style="margin-bottom:14px">
                <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;color:var(--text)">Chọn đích chuyển giao:</label>
                <select id="cskh-transfer-target" style="width:100%;box-sizing:border-box;padding:10px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:13.5px;outline:none;background:#fff">
                    <option value="0">🟡 Trả về hàng đợi (Chờ nhân viên bất kỳ nhận)</option>
                </select>
            </div>
            <div style="margin-bottom:20px">
                <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;color:var(--text)">Ghi chú bàn giao (tùy chọn):</label>
                <input type="text" id="cskh-transfer-note" placeholder="Ví dụ: Khách đang hỏi giá sỉ, nhờ bạn check kho..." style="width:100%;box-sizing:border-box;padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;outline:none">
            </div>
            <div style="display:flex;justify-content:flex-end;gap:10px">
                <button type="button" class="btn btn-outline btn-sm" onclick="closeCskhTransferModal()" style="padding:8px 16px;border-radius:8px">Hủy bỏ</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="submitCskhTransfer()" style="padding:8px 16px;border-radius:8px">Xác nhận chuyển giao</button>
            </div>
        </div>
    </div>
</div>
